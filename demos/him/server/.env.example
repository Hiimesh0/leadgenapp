# ==============================================================
# XYZ Dental Clinic - Doctor Admin & Appointment Backend
# Environment Configuration
# ==============================================================

PORT=5005
NODE_ENV=production
JWT_SECRET=your_jwt_secret_token_change_in_production

# WAHA (WhatsApp HTTP API) Configuration
# In Render cloud: set to internal service URL (e.g. http://waha-whatsapp-service:3000) or public URL
WAHA_BASE_URL=http://localhost:3008
WAHA_API_KEY=your_waha_api_key_here
WAHA_SESSION=default
WAHA_ENABLED=true
