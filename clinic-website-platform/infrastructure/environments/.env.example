# ==============================================================
# AI-Powered Clinic Website Platform - Master Environment Template
# Placeholder values only - Never commit real credentials to Git!
# ==============================================================

# Application & Server
APP_ENV=development
APP_PORT=5050
API_BASE_URL=http://localhost:5050
FRONTEND_ORIGIN=http://localhost:5173,https://hiimesh0.github.io

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# Database Configuration (SQLite default / PostgreSQL for Enterprise)
DATABASE_URL=sqlite:database/campaigns.db
# DATABASE_URL=postgresql://user:pass@host:5432/clinic_db

# WAHA (WhatsApp HTTP API) Gateway
WAHA_BASE_URL=http://localhost:3008
WAHA_API_KEY=your_waha_api_key_here
WAHA_SESSION_NAME=default
WAHA_ENABLED=true
WAHA_WEBHOOK_SECRET=your_waha_webhook_hmac_secret_here

# Cloud Deployment Provider (render | vercel | vps)
DEPLOYMENT_PROVIDER=render
RENDER_API_KEY=
RENDER_SERVICE_ID=
