# ==============================================================
# Standalone Clinic WhatsApp Outreach Campaign Application
# Environment Configuration
# ==============================================================

# Server Configuration
PORT=5050
NODE_ENV=development
APP_SECRET=campaign_admin_jwt_secret_change_in_production_2026

# Admin Credentials (Initial Setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminOutreach@2026

# Existing WAHA (WhatsApp HTTP API) Configuration
# Matches existing clinic WAHA deployment (Docker default: http://localhost:3008 or http://localhost:3000)
WAHA_BASE_URL=http://localhost:3008
WAHA_API_KEY=50100d00397b43cdb9f8a61599cd2f94
WAHA_SESSION=default
WAHA_ENABLED=true

# Campaign Sending Queue Defaults (Conservative Settings)
DEFAULT_BATCH_SIZE=1
DEFAULT_DELAY_SECONDS=10
MAX_BATCH_SIZE=10
MIN_DELAY_SECONDS=5

# Database File Path
DB_PATH=database/campaigns.db

